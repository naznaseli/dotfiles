{
    //:**************************************************
    //! VSCode
    //:**************************************************
    "update.showReleaseNotes": false,

    //:**************************************************
    //! files/editor/workbench/ etc
    //:**************************************************
    "files.encoding": "utf8",
    "files.eol": "\n",
    "files.autoGuessEncoding": true,

    "editor.acceptSuggestionOnCommitCharacter": false,
    "editor.cursorStyle": "block",
    //Vim日本語不具合対応
    "editor.editContext": false,
    "editor.fontFamily": "Ricty Diminished",
    "editor.fontLigatures": "null",
    "editor.fontSize": 14,
    "editor.fontVariations": false,

    //コードの自動整形
    "editor.formatOnSave": false,
    "editor.formatOnType": false,
    "editor.formatOnPaste": false,

    "editor.largeFileOptimizations": false,
    "editor.lineNumbers": "on",
    "editor.minimap.showSlider": "always",
    "editor.minimap.renderCharacters": false,

    "editor.quickSuggestions": {
        "other": "off",
        "comments": "off",
        "strings": "off"
    },
    "editor.renderControlCharacters": true,
    "editor.renderWhitespace": "all",
    //! ユーザスニペットを優先表示
    "editor.snippetSuggestions": "top",

    "editor.unicodeHighlight.nonBasicASCII": false,
    "editor.unicodeHighlight.invisibleCharacters": false,
    "editor.unicodeHighlight.ambiguousCharacters": false,
    "editor.wordSeparators": "/\\()\"':,.;<>~!@#$%^&*|+=[]{}`?-",
    "editor.wordWrap": "off",

    "[html]": {"editor.tabSize": 2},
    "[php]": {"editor.tabSize": 2},
    "[javascript]": {"editor.tabSize": 2},
    "[ruby]": {"editor.tabSize": 2},
    "[yaml]": {
        "editor.insertSpaces": true,
        "editor.tabSize": 2,
        "editor.autoIndent": "advanced"
    },

    "workbench.colorTheme": "Monokai",
    //"workbench.editorAssociations": {
    //    "*.ipynb": "jupyter.notebook.ipynb"
    //},
    "workbench.editor.empty.hint": "hidden",
    //! タブ上書き禁止
    "workbench.editor.enablePreview": false,
    "workbench.settings.applyToAllProfiles": [],
    //! 起動時のエディタ
    "workbench.startupEditor": "none",

    "window.restoreWindows": "none",
    "security.workspace.trust.untrustedFiles": "open",
    "task.problemMatchers.neverPrompt": {
        "shell": true
    },


    //:**************************************************
    //! Terminal
    //:**************************************************
    "terminal.external.windowsExec": "C:\\\\Windows\\\\System32\\\\wsl.exe",
    "terminal.integrated.shell.windows": "C:\\WINDOWS\\System32\\wsl.exe",
    "terminal.integrated.shellArgs.windows": "",
    //"terminal.integrated.shell.linux": "wsl",
    //"terminal.integrated.shellArgs.linux": ["~"],
    "terminal.integrated.fontSize": 14,
    //-l:ログインシェルとして起動
    //"terminal.integrated.automationShell.linux": "",
    //"terminal.integrated.shell.osx": "/usr/bin/fish",
    //"terminal.integrated.allowChords": false,
    //"terminal.integrated.commandsToSkipShell": [
    //    //"workbench.action.terminal.focusFindWidget"
    //],
    //"terminal.integrated.fontWeight": null,
    "terminal.integrated.defaultProfile.windows": "Command Prompt",
    "terminal.integrated.fontFamily": "monospace",

    //:**************************************************
    //! Explorer
    //:**************************************************
    "explorer.confirmDelete": false,
    "explorer.confirmDragAndDrop": false,

    //:**************************************************
    //! Vim
    //:**************************************************
    "vim.normalModeKeyBindingsNonRecursive": [
        {   "before": [";"],                "after": [":"]},
        {   "before": [":"],                "after": [";"]},
        //! VSCodeのショートカットキーを優先。サイドバーの表示非表示切り替え
        {   "before": ["<C-b>"],            "commands": ["workbench.action.toggleSidebarVisibility"]},
    ],
    //"vim.cmdLineInitialColon": true,
    "vim.easymotion": false,
    //システムのクリップボードにコピー
    "vim.useSystemClipboard": true,
    //ctrlキーを使った操作が有効になる(vimのキーバインド>VSCodeのショートカット)
    "vim.useCtrlKeys": true,
    //検索結果のハイライト
    "vim.hlsearch": true,

    //:**************************************************
    //! Git
    //:**************************************************
    "git.ignoreMissingGitWarning": true,

    //:**************************************************
    //! GitLens
    //:**************************************************
    "gitlens.codeLens.dateFormat": "",
    "gitlens.currentLine.pullRequests.enabled": false,

    //:**************************************************
    //! Latex
    //:**************************************************
    "latex-workshop.chktex.enabled": true,
    "latex-workshop.latex.recipes": [
        {
            "name": "ptex2pdf",
            "tools": [
                "ptex2pdf"
            ]
        }
    ],
    "latex-workshop.latex.tools": [
        {
            "args": [
                "-l",
                "-ot",
                "-kanji=utf8 -synctex=1",
                "%DOC%"
            ],
            "command": "ptex2pdf",
            "name": "ptex2pdf"
        }
    ],
    "latex-workshop.message.update.show": false,
    "latex-workshop.view.pdf.viewer": "tab",

    //:**************************************************
    //! C/C++
    //:**************************************************
    "C_Cpp.updateChannel": "Insiders",
    "C_Cpp.clang_format_style": "Visual Studio",
   
    //:**************************************************
    //! Arduino
    //:**************************************************
    "arduino.useArduinoCli": true,

    //:**************************************************
    //! TypeScript
    //:**************************************************
    "typescript.experimental.tsserver.web.enableProjectWideIntellisense": true,

    //:**************************************************
    //! code-eol
    //:**************************************************
    "code-eol.color": "#00FFFF",

    //:**************************************************
    //! Added
    //:**************************************************
}